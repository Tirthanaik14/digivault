# ── Database ──────────────────────────────────────────────────────────────────
# Replace with your actual PostgreSQL credentials
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/kyc_aml

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme_generate_a_real_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── Blockchain (Hardhat / Ganache local node) ─────────────────────────────────
# Start Hardhat: npx hardhat node
# Start Ganache: ganache --port 8545
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
# The private key of account[0] from your Hardhat/Ganache node
DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# ── UIDAI Certificate ─────────────────────────────────────────────────────────
# Download from: https://uidai.gov.in/images/authDoc/uidai_auth_prod.cer
# Place the file in:  backend/certs/uidai_auth_prod.cer
UIDAI_CERT_PATH=certs/uidai_auth_prod.cer

# ── Face Match Threshold (0.0 – 1.0) ─────────────────────────────────────────
FACE_MATCH_THRESHOLD=0.60

# ── CORS origin for local React dev server ────────────────────────────────────
CORS_ORIGIN=http://localhost:5173
